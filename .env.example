# ============================================================
# JARVIS ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in your keys.
# Only JARVIS_AI_CLIENT is required for Ollama (local/free).
# ============================================================

# ----- AI Provider Selection --------------------------------
# Choose which AI brain Jarvis uses to answer questions.
# Options: ollama | openai | claude | gemini | openrouter
JARVIS_AI_CLIENT=ollama

# Optional: Override the model. Leave blank to use the default.
# Defaults: ollama->qwen3:8b | openai->gpt-4o-mini | claude->claude-3-5-haiku | gemini->gemini-1.5-flash
JARVIS_AI_MODEL=

# ----- Local Ollama (default, no API key needed) ------------
# Install Ollama and run: ollama pull qwen3:8b

# ----- OpenAI (GPT-4o, GPT-4o-mini) ------------------------
OPENAI_API_KEY=

# ----- Anthropic Claude (claude-3-5-sonnet, claude-3-haiku) -
ANTHROPIC_API_KEY=

# ----- Google Gemini (gemini-1.5-flash, gemini-1.5-pro) -----
GOOGLE_API_KEY=

# ----- OpenRouter (800+ models via one API) -----------------
OPENROUTER_API_KEY=

# ----- ElevenLabs Voice Design (optional) -------------------
ELEVENLABS_API_KEY=
BOB_VOICE_ID=

# ----- Jarvis Voice (Edge TTS) ------------------------------
# Default: en-GB-RyanNeural  (classic British Jarvis voice)
# Options: en-GB-ThomasNeural | en-US-GuyNeural | en-US-AriaNeural
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_RATE=+10%
JARVIS_PITCH=+0Hz

# ----- Speech Recognition (faster-whisper) -------------------
# Options: base.en (instant ~0.5s, high accuracy) | small.en (Google Voice-grade, ~1.4s)
JARVIS_STT_MODEL=base.en
